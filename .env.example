# Copia este archivo como ".env.local" y llena los valores de tu proyecto de Firebase
# Transición: conservar legacy hasta registrar OAuth, migrar vínculos y bloquear acceso directo.
VITE_AUTH_MODE=legacy
# Solo al activar central; distinto Client ID para cada origen. Sin client secret.
VITE_AULA_CLIENT_ID=
VITE_EDUCATIONAL_API_URL=http://localhost:3001
# URLs centrales e issuer están fijados en src/lib/central.ts (no requieren claves).
# Callback local: http://localhost:5173/?auth_callback=1
# Callback público: https://rodolfoluna.github.io/arbolesapp/?auth_callback=1
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web > firebaseConfig)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correo con el que TÚ (profesor) inicias sesión. Debe coincidir con firestore.rules
VITE_TEACHER_EMAIL=profesor@ejemplo.com

# Dominio ficticio para los correos sintéticos de los alumnos (22010456@arboles.app)
VITE_EMAIL_DOMAIN=arboles.app
